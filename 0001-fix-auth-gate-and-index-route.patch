diff --git a/src/app/_layout.jsx b/src/app/_layout.jsx
new file mode 100644
index 0000000..e28ba6e
--- /dev/null
+++ b/src/app/_layout.jsx
@@ -0,0 +1,40 @@
+import { Stack } from 'expo-router';
+import * as SplashScreen from 'expo-splash-screen';
+import { useEffect } from 'react';
+import { AuthProvider, useAuth } from '../auth/AuthContext';
+
+// Keep the splash screen up until we know whether the user is signed in
+SplashScreen.preventAutoHideAsync().catch(() => {});
+
+function RootNavigator() {
+  const { isReady, isAuthenticated } = useAuth();
+
+  useEffect(() => {
+    if (isReady) SplashScreen.hideAsync().catch(() => {});
+  }, [isReady]);
+
+  if (!isReady) return null;
+
+  return (
+    <Stack screenOptions={{ headerShown: false }}>
+      {/* App entry: redirects to the right group based on auth state */}
+      <Stack.Screen name="index" />
+
+      <Stack.Protected guard={isAuthenticated} redirectTo="/(unauth)/regAuth">
+        <Stack.Screen name="(auth)" />
+      </Stack.Protected>
+
+      <Stack.Protected guard={!isAuthenticated} redirectTo="/(auth)/contacts">
+        <Stack.Screen name="(unauth)" />
+      </Stack.Protected>
+    </Stack>
+  );
+}
+
+export default function RootLayout() {
+  return (
+    <AuthProvider>
+      <RootNavigator />
+    </AuthProvider>
+  );
+}
diff --git a/src/app/index.jsx b/src/app/index.jsx
new file mode 100644
index 0000000..bf90ef7
--- /dev/null
+++ b/src/app/index.jsx
@@ -0,0 +1,12 @@
+import { Redirect } from 'expo-router';
+import { useAuth } from '../auth/AuthContext';
+
+// App entry route ("/"). Sends the user to the chat list when signed in,
+// otherwise to registration.
+export default function Index() {
+  const { isAuthenticated } = useAuth();
+
+  return (
+    <Redirect href={isAuthenticated ? '/(auth)/contacts' : '/(unauth)/regAuth'} />
+  );
+}
diff --git a/src/auth/AuthContext.jsx b/src/auth/AuthContext.jsx
new file mode 100644
index 0000000..99030a7
--- /dev/null
+++ b/src/auth/AuthContext.jsx
@@ -0,0 +1,58 @@
+import * as SecureStore from 'expo-secure-store';
+import { createContext, useCallback, useContext, useEffect, useState } from 'react';
+
+// Same keys that (unauth)/regAuth.jsx writes after a successful registration
+const USER_ID_KEY = 'secure_user_id';
+const PLAIN_TOKEN_KEY = 'secure_plain_token';
+
+const AuthContext = createContext({
+  isReady: false,
+  isAuthenticated: false,
+  refreshSession: async () => {},
+  signOut: async () => {},
+});
+
+export function AuthProvider({ children }) {
+  const [isReady, setIsReady] = useState(false);
+  const [token, setToken] = useState(null);
+
+  // Reads the stored credentials and updates auth state.
+  // Call again after registration so route guards pick up the new session.
+  const refreshSession = useCallback(async () => {
+    try {
+      const stored = await SecureStore.getItemAsync(PLAIN_TOKEN_KEY);
+      setToken(stored || null);
+    } catch (error) {
+      console.error('Auth session read failure:', error);
+      setToken(null);
+    } finally {
+      setIsReady(true);
+    }
+  }, []);
+
+  const signOut = useCallback(async () => {
+    try {
+      await SecureStore.deleteItemAsync(PLAIN_TOKEN_KEY);
+      await SecureStore.deleteItemAsync(USER_ID_KEY);
+    } catch (error) {
+      console.error('Auth sign-out failure:', error);
+    }
+    setToken(null);
+  }, []);
+
+  useEffect(() => {
+    refreshSession();
+  }, [refreshSession]);
+
+  return (
+    <AuthContext.Provider
+      value={{ isReady, isAuthenticated: !!token, refreshSession, signOut }}
+    >
+      {children}
+    </AuthContext.Provider>
+  );
+}
+
+export function useAuth() {
+  return useContext(AuthContext);
+}
